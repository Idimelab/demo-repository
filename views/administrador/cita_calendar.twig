{% extends "baseDocument.twig" %}
{% block header_styles %}

    {# --- FullCalendar CSS (CDN) --- #}
    {# Visita https://fullcalendar.io/docs/initialize-globals para las últimas versiones/CDN #}
    <link href='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/main.min.css' rel='stylesheet' />
    {# CSS para Select2 (opcional, si lo usas para filtros) #}
    {# <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" /> #}
    <style>
        /* Ajustes opcionales para FullCalendar */
        #calendar {
            max-width: 1100px;
            margin: 0 auto;
        }
        /* Estilo para eventos en el calendario (ejemplo) */
        .fc-event { cursor: pointer; }
        .fc-event-main { padding: 4px 6px; }
        /* Colores por estado (ejemplos, ajustar clases CSS en JS) */
        .fc-event-programada { background-color: #0dcaf0; border-color: #0dcaf0; } /* Info */
        .fc-event-confirmada { background-color: #0d6efd; border-color: #0d6efd; } /* Primary */
        .fc-event-realizada { background-color: #198754; border-color: #198754; } /* Success */
        .fc-event-cancelada_auxiliar, .fc-event-cancelada_paciente { background-color: #dc3545; border-color: #dc3545; } /* Danger */
        .fc-event-no_asistio { background-color: #6c757d; border-color: #6c757d; } /* Secondary */
    </style>

{% endblock %}

