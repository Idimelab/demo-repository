{% extends "baseDocument.twig" %}

{% block content %}
    <div class="container mt-4">
        <div class="row">
            <div class="col-lg-10 offset-lg-1">
                <div class="card shadow">
                    <div class="card-header">
                        <div class="row align-items-center">
                            <div class="col-8">
                                <h2 class="mb-0">Detalle Cotización #{{ cotizacion.id_cotizacion }} <i class="fas fa-file-alt ms-2"></i></h2>
                            </div>
                            <div class="col-4 text-end">
                                <a href="?class=cotizaciones&action=edit&id={{ cotizacion.id_cotizacion }}" class="btn btn-sm btn-info me-1">
                                    <i class="fas fa-edit me-1"></i> Editar Estado/Notas
                                </a>
                                <a href="?class=cotizaciones&action=list" class="btn btn-sm btn-secondary">
                                    <i class="fas fa-arrow-left me-1"></i> Volver a la Lista
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        {# --- Información Cabecera --- #}
                        <h6 class="heading-small text-muted mb-4">Información General</h6>
                        <div class="row mb-3">
                            <div class="col-md-4"><strong>ID Cotización:</strong> #{{ cotizacion.id_cotizacion }}</div>
                            <div class="col-md-4"><strong>Fecha Creación:</strong> {{ cotizacion.fecha_cotizacion | date('Y-m-d H:i:s') }}</div>
                            <div class="col-md-4">
                                <strong>Estado:</strong>
                                {% set badge_class = 'secondary' %}
                                {% if cotizacion.estado == 'Pendiente' %} {% set badge_class = 'warning text-dark' %} {# text-dark para mejor contraste en amarillo #}
                                {% elseif cotizacion.estado == 'Completada' %} {% set badge_class = 'success' %}
                                {% elseif cotizacion.estado == 'Expirada' %} {% set badge_class = 'danger' %}
                                {% endif %}
                                <span class="badge bg-{{ badge_class }}">{{ cotizacion.estado }}</span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-8">
                                <strong>Cliente:</strong>
                                {{ cotizacion.nombre_usuario }} {{ cotizacion.apellido_usuario }}
                                (<a href="mailto:{{ cotizacion.email_usuario }}">{{ cotizacion.email_usuario }}</a>)
                                {# Podrías añadir link al perfil del usuario si existe: #}
                                {# <a href="?class=usuarios&action=edit&id={{ cotizacion.id_usuario }}">(Ver Usuario)</a> #}
                            </div>
                            <div class="col-md-4"><strong>Vigencia Hasta:</strong> {{ cotizacion.vigencia_hasta ? cotizacion.vigencia_hasta | date('Y-m-d') : 'N/A' }}</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <strong>Observaciones:</strong><br>
                                <p class="border p-2 rounded bg-light">{{ cotizacion.observaciones | default('Sin observaciones.') | nl2br }}</p> {# nl2br para saltos de línea #}
                            </div>
                        </div>

                        <hr class="my-4">
                        {# --- Tabla de Detalles (Exámenes) --- #}
                        <h6 class="heading-small text-muted mb-4">Exámenes Incluidos</h6>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered">
                                <thead class="table-light">
                                <tr>
                                    <th>Código Examen</th>
                                    <th>Nombre Examen</th>
                                    <th class="text-center">Cantidad</th>
                                    <th class="text-end">Precio Unit. (Cotizado)</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% if cotizacion.detalles is not empty %}
                                    {% for detalle in cotizacion.detalles %}
                                        <tr>
                                            <td>{{ detalle.codigo_examen | default('N/A') }}</td>
                                            <td>{{ detalle.nombre_examen }}</td>
                                            <td class="text-center">{{ detalle.cantidad }}</td>
                                            <td class="text-end">${{ detalle.precio_unitario_registrado | number_format(2, ',', '.') }}</td>
                                            <td class="text-end">${{ detalle.subtotal | number_format(2, ',', '.') }}</td>
                                        </tr>
                                    {% endfor %}
                                {% else %}
                                    <tr>
                                        <td colspan="5" class="text-center fst-italic">No hay exámenes en esta cotización.</td>
                                    </tr>
                                {% endif %}
                                </tbody>
                                {% if cotizacion.detalles is not empty %}
                                    <tfoot>
                                    <tr class="table-light">
                                        <td colspan="4" class="text-end fw-bold">Precio Total Calculado:</td>
                                        <td class="text-end fw-bold">${{ cotizacion.precio_total_calculado | default(0) | number_format(2, ',', '.') }}</td>
                                    </tr>
                                    </tfoot>
                                {% endif %}
                            </table>
                        </div>
                        {# --- Fin Detalles --- #}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block footer_scripts %}
    <script>
        const tipo = "view";
        const cotizacion_id = "{{ cotizacion.id_cotizacion }}";
    </script>
    {# Probablemente no necesita JS específico, pero lo incluimos por consistencia #}
    <script type="text/javascript" src="{{ general.full_assets_url }}js/admin/cotizacion.js"></script>
{% endblock %}