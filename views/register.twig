{# views/register.html.twig #}
<!DOCTYPE html>
<html lang="es">
<head>
    <title>Idem - Registro de Pacientes</title> {# Título específico #}

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="description" content="Registro de nuevos pacientes en Idem Laboratorio"> {# Descripción específica #}
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <link rel="stylesheet" type="text/css" href="{{ general.full_assets_url }}css/login.css"> {# O register.css #}

    <script src="{{ general.full_assets_url }}template/argon-dashboard-master/js/plugins/jquery/dist/jquery.min.js"></script>

</head>
<style>
    /* Estilos básicos para layout de Login y Registro */
    body, html {
        height: 100%;
        margin: 0;
        font-family: sans-serif; /* Considera una fuente más específica si lo deseas */
        overflow-x: hidden; /* Evitar scroll horizontal si algo se desborda */
    }

    .login-container { /* Contenedor principal que ocupa toda la pantalla */
        padding: 0;
        overflow-y: auto; /* Permitir scroll vertical si el contenido es muy alto en pantallas pequeñas */
        min-height: 100vh; /* Asegurar altura mínima */
    }

    .login-left-column {
        /* --- IMAGEN DE FONDO --- */
        /* Reemplaza la URL con la ruta a tu imagen real */
        background: url('https://www.medvidasalud.com/wp-content/uploads/que-es-un-laboratorio-clinico-medvida-salud.webp') no-repeat center center;
        /* background: url('../img/tu_imagen_de_fondo.jpg') no-repeat center center; */
        background-size: cover;
        position: relative; /* Necesario para el overlay y el posicionamiento absoluto del footer */
        color: #fff; /* Color de texto por defecto para esta columna */
        display: flex; /* Usar flexbox para controlar contenido */
        flex-direction: column; /* Apilar elementos verticalmente */
        justify-content: space-between; /* Empujar header y footer a los extremos */
        min-height: 100vh; /* Asegurar que ocupe toda la altura en pantallas grandes */
    }

    /* Overlay oscuro sobre la imagen de fondo para mejorar legibilidad */
    .login-left-column::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.35); /* Ajusta opacidad (0.35 = 35%) */
        z-index: 1; /* Detrás del contenido, sobre la imagen */
    }

    /* Contenido directo de la columna izquierda debe estar sobre el overlay */
    .login-left-column > div { /* Afecta a los divs directos (header y footer de contacto) */
        position: relative;
        z-index: 2;
    }

    /* Estilos para el header (logo, nav) en columna izquierda */
    .login-left-column .navbar-nav .nav-link { /* Estilo específico si quieres para la nav */
        color: rgba(255, 255, 255, 0.8);
        font-weight: 300; /* Más ligero */
        padding: 0.5rem 0; /* Ajustar padding */
    }
    .login-left-column .navbar-nav .nav-link:hover {
        color: #fff;
    }


    /* Estilos para detalles de contacto en columna izquierda */
    .contact-details {
        background-color: rgba(0, 80, 70, 0.65); /* Fondo semi-transparente (ejemplo verde oscuro) */
        border-top-left-radius: 10px;
        border-top-right-radius: 10px;
        backdrop-filter: blur(4px); /* Efecto blur leve si el navegador soporta */
        margin-top: auto; /* Empujar al fondo si el contenido no llena el alto */
    }

    .contact-details small {
        opacity: 0.8; /* Hacer el label "Telefono", "E-Mail" un poco más tenue */
        font-size: 0.8rem; /* Tamaño más pequeño */
        text-transform: uppercase; /* Opcional: mayúsculas */
    }
    .contact-details span.fw-light { /* Texto de la información de contacto */
        font-size: 0.9rem;
    }
    .contact-details i.fa-fw { /* Iconos */
        opacity: 0.7;
    }

    /* Columna Derecha (Formulario) */
    .login-right-column {
        background-color: #f4f7fa; /* Un gris muy claro o blanco */
        display: flex;
        align-items: center; /* Centrar verticalmente */
        justify-content: center; /* Centrar horizontalmente */
        padding: 2rem 1rem; /* Padding para pantallas pequeñas */
        min-height: 100vh; /* Asegurar altura mínima también */
    }

    /* Contenedor del formulario */
    .login-form-container {
        width: 100%;
        max-width: 500px; /* Ancho máximo para el formulario, ajusta si es necesario */
        background-color: #fff;
        padding: 2.5rem; /* Padding interno */
        border-radius: 0.5rem;
        box-shadow: 0 0.75rem 1.5rem rgba(18,38,63,.03); /* Sombra sutil tipo Argon */
        border: 1px solid #e9ecef; /* Borde ligero */
    }

    /* Ajustes específicos para el formulario de registro si es necesario */
    #registerForm .form-label {
        font-size: 0.875rem; /* Tamaño etiquetas */
        font-weight: 600;
    }

    /* Estilo general de inputs y selects */
    .form-control, .form-select {
        border: 1px solid #cad1d7;
        transition: all .15s ease-in-out;
    }
    .form-control:focus, .form-select:focus {
        border-color: #5e72e4; /* Color de borde al enfocar (ejemplo Argon) */
        box-shadow: 0 0 0 0.2rem rgba(94, 114, 228, 0.25);
    }

    /* Estilo para inputs inválidos */
    .form-control.is-invalid, .form-select.is-invalid {
        border-color: #f5365c; /* Rojo Argon para errores */
    }
    .form-control.is-invalid:focus, .form-select.is-invalid:focus {
        border-color: #f5365c;
        box-shadow: 0 0 0 0.2rem rgba(245, 54, 92, 0.25);
    }
    .invalid-feedback {
        font-size: 0.8em; /* Feedback de error más pequeño */
    }


    /* Estilo Botones (Reutilizable Login/Registro) */
    .login-form-container .btn-lg { /* Botones principales */
        padding: 0.875rem 1rem;
        font-size: 0.9rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .05em;
    }

    /* Color específico botón registro (si usas .btn-success) */
    .btn-success {
        background-color: #2dce89; /* Verde Argon */
        border-color: #2dce89;
    }
    .btn-success:hover {
        background-color: #26ab74;
        border-color: #24a06c;
    }
    /* Color específico botón login (si usas
</style>

<body>

<div class="container-fluid vh-100 login-container"> {# Reutiliza clase de login #}
    <div class="row h-100">
        <div class="col-lg-7 d-none d-lg-flex flex-column justify-content-between login-left-column">
            {# Área Superior Izquierda (Logo y Navegación simplificada para no autenticados) #}
            <div class="p-4">
                <img src="https://via.placeholder.com/150x50?text=Idem+Logo" alt="Logo Idem" style="max-height: 50px;">
                {# Podrías quitar o simplificar la nav aquí #}
                {# <nav class="mt-3">
                     <a href="#" class="text-white text-decoration-none me-3 fw-light">INICIO</a>
                 </nav> #}
            </div>

            {# Fondo (vía CSS) #}

            {# Área Inferior Izquierda (Contacto - Igual que Login) #}
            <div class="p-4 text-white contact-details">
                {# ... (Mismos detalles de contacto que en login.html.twig) ... #}
                <div class="row">
                    <div class="col-md-6 mb-3"><small><i class="fas fa-phone fa-fw me-2"></i><strong>Telefono</strong></small><br><span class="fw-light">+57 324 5344689</span></div>
                    <div class="col-md-6 mb-3"><small><i class="fas fa-envelope fa-fw me-2"></i><strong>E-Mail</strong></small><br><span class="fw-light">contacto@idem.com.co</span></div>
                    <div class="col-md-6 mb-3"><small><i class="fas fa-globe fa-fw me-2"></i><strong>Sitio web</strong></small><br><span class="fw-light">www.idem.com.co</span></div>
                    <div class="col-md-6 mb-3"><small><i class="fas fa-map-marker-alt fa-fw me-2"></i><strong>Direccion</strong></small><br><span class="fw-light">Carrera X # Y-Z</span></div>
                </div>
            </div>
        </div>

        <div class="col-lg-5 col-md-12 d-flex align-items-center justify-content-center login-right-column">
            <div class="login-form-container p-4 p-md-5"> {# Aumentar padding si es necesario #}
                <h2 class="fw-bold mb-2 text-center">Creá tu Cuenta</h2> {# Título cambiado #}
                <p class="text-muted mb-4 text-center">Completá tus datos para agendar citas y ver resultados.</p> {# Subtítulo cambiado #}

                {# --- FORMULARIO DE REGISTRO --- #}
                <form id="registerForm" novalidate>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="reg-nombre" class="form-label">Nombres <span class="text-danger">*</span></label>
                            <input type="text" id="reg-nombre" class="form-control js-nombre" required>
                            <div class="invalid-feedback">Ingresa tu nombre.</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="reg-apellido" class="form-label">Apellidos <span class="text-danger">*</span></label>
                            <input type="text" id="reg-apellido" class="form-control js-apellido" required>
                            <div class="invalid-feedback">Ingresa tus apellidos.</div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="reg-tipo-documento" class="form-label">Tipo Documento <span class="text-danger">*</span></label>
                            <select id="reg-tipo-documento" class="form-select js-tipo-documento" required>
                                <option value="" selected disabled>Selecciona...</option>
                                <option value="CC">CC - Cédula Ciudadanía</option>
                                <option value="CE">CE - Cédula Extranjería</option>
                                <option value="TI">TI - Tarjeta Identidad</option>
                                <option value="PAS">PAS - Pasaporte</option>
                            </select>
                            <div class="invalid-feedback">Selecciona un tipo.</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="reg-documento" class="form-label">Número Documento <span class="text-danger">*</span></label>
                            <input type="text" id="reg-documento" class="form-control js-documento" required>
                            <div class="invalid-feedback">Ingresa tu número de documento.</div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="reg-email" class="form-label">Correo Electrónico <span class="text-danger">*</span></label>
                            <input type="email" id="reg-email" class="form-control js-email" placeholder="tu@email.com" required>
                            <div class="invalid-feedback">Ingresa un email válido.</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="reg-telefono" class="form-label">Teléfono</label>
                            <input type="tel" id="reg-telefono" class="form-control js-telefono" placeholder="(Opcional)">
                        </div>
                    </div>

                    {# Campos Opcionales Adicionales #}
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="reg-fecha-nacimiento" class="form-label">Fecha de Nacimiento</label>
                            <input type="date" id="reg-fecha-nacimiento" class="form-control js-fecha-nacimiento" >
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="reg-eps" class="form-label">EPS</label>
                            <input type="text" id="reg-eps" class="form-control js-eps" placeholder="(Opcional)">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label for="reg-direccion" class="form-label">Dirección</label>
                            <input type="text" id="reg-direccion" class="form-control js-direccion" placeholder="(Opcional)">
                        </div>
                    </div>

                    <hr class="my-3">

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="reg-password" class="form-label">Contraseña <span class="text-danger">*</span></label>
                            <input type="password" id="reg-password" class="form-control js-password" placeholder="Mínimo 6 caracteres" required>
                            <div class="invalid-feedback">La contraseña es requerida (mínimo 6 caracteres).</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="reg-password-confirm" class="form-label">Confirmar Contraseña <span class="text-danger">*</span></label>
                            <input type="password" id="reg-password-confirm" class="form-control js-password-confirm" placeholder="Repite la contraseña" required>
                            <div class="invalid-feedback">Las contraseñas no coinciden.</div>
                        </div>
                    </div>

                    {# Mensaje de Error General #}
                    <div id="form-error-message" class="alert alert-danger d-none mt-3" role="alert"></div>
                    {# Mensaje de Éxito General #}
                    <div id="form-success-message" class="alert alert-success d-none mt-3" role="alert"></div>


                    {# Botón Registrarme #}
                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-success btn-lg js-register-button"> {# Botón cambiado #}
                            Registrarme
                        </button>
                    </div>

                </form>
                {# --- FIN FORMULARIO --- #}

                {# Enlace a Login #}
                <div class="text-center mt-4">
                    <a href="{{ general.full_web_url }}" class="text-muted text-decoration-none small">¿Ya tenés cuenta? Ingresá aquí</a> {# Ajusta la URL del login si es diferente #}
                </div>

            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

<script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    const FULL_WEB_URL = '{{ general.full_web_url | default('/') }}';
</script>

<script type="text/javascript" src="{{ general.full_assets_url }}js/register.js"></script> {# Nuevo archivo JS #}

</body>
</html>